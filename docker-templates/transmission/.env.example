TRANSMISSION_ENABLED=false

# https://haugene.github.io/docker-transmission-openvpn/config-options/

# this docker image requires a VPN
# https://haugene.github.io/docker-transmission-openvpn/supported-providers/
OPENVPN_PASSWORD=
OPENVPN_USERNAME=
OPENVPN_PROVIDER=

TRANSMISSION_BLOCKLIST_ENABLED=true
TRANSMISSION_BLOCKLIST_URL=https://github.com/Naunter/BT_BlockLists/raw/master/bt_blocklists.gz
TRANSMISSION_RPC_PASSWORD=password
TRANSMISSION_RPC_USERNAME=user
HEALTH_CHECK_HOST=google.com
# TRANSMISSION_DOWNLOAD_QUEUE_SIZE=10

# alternate web UIs
# https://haugene.github.io/docker-transmission-openvpn/config-options/#alternative_web_uis
TRANSMISSION_WEB_UI=flood-for-transmission
# flood looks nice and has "add tracker" feature

TRANSMISSION_WATCH_DIR=/lochnas/home/transmission/watch
TRANSMISSION_DOWNLOAD_DIR=/lochnas/home/transmission/completed
TRANSMISSION_INCOMPLETE_DIR=/lochnas/home/transmission/incomplete
